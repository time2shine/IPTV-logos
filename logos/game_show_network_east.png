entById("main-wrapper")?.classList.contains("homepage");e.addEventListener("click",o=>{if(s)if(o.preventDefault(),a){const i=document.getElementById(s);i&&(i.scrollIntoView({behavior:"smooth"}),r())}else window.location.href=`/homepage?nav=${s}`;else t&&t!=="#"?r():o.preventDefault()})})}function d(){const n=document.getElementById("slideMenu"),e=document.querySelector(".sony-header");if(!n)return;function t(){const s=e?e.offsetHeight:0;n.style.setProperty("--sony-header-height",`${s}px`)}t(),e&&new ResizeObserver(t).observe(e),window.addEventListener("resize",t)}function r(){const n=document.getElementById("slideMenu"),e=document.getElementById("main-wrapper"),t=document.getElementById("hamburger-btn");n?.classList.remove("open"),e?.classList.remove("menu-open"),t?.classList.remove("is-active")}</script> </header><script type="module">const nav_mini_mode_only = false;
const menuItems = [{"label":"Schedule","url":{"id":"aUWxSxEAACEA8c5M","type":"page","tags":["schedule","page","shows","main page"],"lang":"en-us","slug":"the-perfect-line","first_publication_date":"2025-12-19T20:13:14+0000","last_publication_date":"2026-04-20T19:02:39+0000","uid":"schedule","link_type":"Document","key":"d4466b2d-84c9-4589-a31c-f9d734d94b50","isBroken":false},"jump_to_section":""},{"label":"Shows","url":{"id":"aR-LTRIAACcA8yuF","type":"page","tags":["shows","page","main page"],"lang":"en-us","slug":"weeknights-6p-et","first_publication_date":"2025-11-20T21:43:17+0000","last_publication_date":"2026-08-04T23:37:27+0000","uid":"shows","link_type":"Document","key":"00615e8e-0465-45c8-8bb9-6b36a4490dc7","isBroken":false},"jump_to_section":""},{"label":"Watch","url":{"id":"aUn9bBEAACEA-HpU","type":"page","tags":["video gallery","page","main page"],"lang":"en-us","slug":"watch-full-episodes-of-your-favorite-game-shows","first_publication_date":"2025-12-23T02:27:41+0000","last_publication_date":"2026-03-19T21:10:22+0000","uid":"video-gallery","link_type":"Document","key":"0e8abf24-f3d6-4c94-97e8-16bc830cb98c","isBroken":false},"jump_to_section":""},{"label":"Games","url":{"link_type":"Web","key":"f3653872-45fa-45d0-9a22-546173a147dd","url":"https://games.gameshownetwork.com/","target":"_blank"},"jump_to_section":""},{"label":"Find Us","url":{"link_type":"Web","key":"9f06245a-da73-4421-b001-b517c0cdd9d8","url":"#lightbox:channel-finder-r0"},"jump_to_section":""},{"label":"Insider","url":{"id":"aVY54xEAAIVYC3PQ","type":"page","tags":["insider","page"],"lang":"en-us","slug":"go-behind-the-scenes-with","first_publication_date":"2026-01-01T09:13:48+0000","last_publication_date":"2026-04-01T05:33:02+0000","uid":"insider","link_type":"Document","key":"cf55b09c-66fb-4118-ae64-cc6308a1225d","isBroken":false},"jump_to_section":""}];


const NAV_MINI_ONLY = nav_mini_mode_only;

if(menuItems.length === 0) {
  // Handle case when there are no menu items
	// console.log("no nav items");
	initNavMorph();
	initBodyPadding();
} else {
	initMobileNavLSwitch();
	initNavMorph();
	initMobileNav();
	initNavIndicator();
	initJumpToSection();
	initBodyPadding();
}

function initNavIndicator() {
  const nav = document.querySelector('.nav');
  const links = nav.querySelectorAll('.navItem');

  function movePill(target) {
    if (!target) return;
    const rect = target.getBoundingClientRect();
    const navRect = nav.getBoundingClientRect();

    nav.style.setProperty('--pill-width', `${rect.width}px`);
    nav.style.setProperty('--pill-x', `${rect.left - navRect.left}px`);

    // Remove pill-active from all links
    links.forEach(link => link.classList.remove('pill-active'));
    // Add to target
    if (target) target.classList.add('pill-active');
  }

  // For each nav item
  links.forEach(link => {

    // Mouse enters an item → show + move pill
    link.addEventListener('mouseenter', () => {
      nav.classList.remove('pill-hide');
      movePill(link);
    });

		// Mouse leaves this item → hide pill
		// if nav has a selected item, move pill to that item
		link.addEventListener('mouseleave', () => {
			const selectedLink = nav.querySelector('.navItem.selected');
			if (selectedLink) {
			nav.classList.remove('pill-hide');
			movePill(selectedLink);
			} else {
			nav.classList.add('pill-hide');
			links.forEach(link => link.classList.remove('pill-active'));
			}
		});
  });

	// On page load, if there's a selected item, position pill there
	window.addEventListener('load', () => {
		const selectedLink = nav.querySelector('.navItem.selected');
		if (selectedLink) {
			movePill(selectedLink);
		} else {
			nav.classList.add('pill-hide');	
			links.forEach(link => link.classList.remove('pill-active'));
		}
	});

	// Watch for header class changes (e.g. `mini` added/removed) and reposition pill
	// This ensures the active marker updates when switching between full/mini modes
	const headerEl = document.querySelector('header');
	if (headerEl) {
		const headerObserver = new MutationObserver(mutations => {
			for (const m of mutations) {
				if (m.type === 'attributes' && m.attributeName === 'class') {
					const selectedLink = nav.querySelector('.navItem.selected');
					// If nav is hidden (collapsed) or no selected link, hide the pill
					if (nav.classList.contains('hide') || !selectedLink) {
						nav.classList.add('pill-hide');
						links.forEach(link => link.classList.remove('pill-active'));
					} else {
						nav.classList.remove('pill-hide');
						movePill(selectedLink);
					}
				}
			}
		});

		headerObserver.observe(headerEl, { attributes: true, attributeFilter: ['class'] });
	}
}

function initJumpToSection() {
	const links = document.querySelectorAll('.nav .navItem[data-target]');
	const isHomepage = document.getElementById('main-wrapper')?.classList.contains('homepage');

	links.forEach(link => {
		const target = link.getAttribute('data-target');
		if (!target) return;

		link.addEventListener('click', (e) => {
			e.preventDefault();

			if (isHomepage) {
				// Already on the page — scroll smoothly to the section
				const section = document.getElementById(target);
				if (section) {
					section.scrollIntoView({ behavior: 'smooth' });
				}
			} else {
				// Navigate to the homepage and let it scroll on load
				window.location.href = `/homepage?nav=${target}`;
			}
		});
	});
}

function initNavMorph() {
	const header = document.querySelector('header');
	if (!header) return;
	
	// If CMS forces mini-mode only, apply mini class and skip scroll listener
	if (NAV_MINI_ONLY) {
		header.classList.add('mini');
		return;
	}
	
	window.addEventListener('scroll', () => {
		//console.log("Scroll Y", window.scrollY);

		if (window.scrollY > 100) {
			// add "mini" class to "header"
			header.classList.add('mini');
		} else {
			// remove "mini" class from "header"
			header.classList.remove('mini');
		}
	});
}

function initMobileNavLSwitch() {
	const logo = document.querySelector('.site-logo');
	const nav = document.querySelector('.nav');
	const hamburgerBtn = document.getElementById('hamburger-btn');
	const header = document.querySelector('header');

	if (!nav || !hamburgerBtn || !header) return;

	// Batch checks to one per animation frame to prevent rapid-fire calls during resize
	let checkScheduled = false;

	function checkNavVisibility() {
		if (checkScheduled) return;
		checkScheduled = true;
		requestAnimationFrame(() => {
			_doCheck();
			checkScheduled = false;
		});
	}

	function _doCheck() {
		const hadMini = header.classList.contains('mini');

		// Suppress all transitions so our temporary class manipulation is invisible
		header.style.transition = 'none';
		nav.style.transition = 'none';
		if (logo) logo.style.transition = 'none';

		// Strip BOTH mini and hamburger-active so we always measure at the same
		// base state — logo at full size, nav visible. This prevents the oscillation
		// where the shrinking logo causes the next check to think there's space again.
		header.classList.remove('mini', 'hamburger-active');
		nav.classList.remove('hide');

		// Force reflow so the browser applies the stripped state before measuring
		void header.offsetHeight;

		const navRect = nav.getBoundingClientRect();
		const logoRight = logo ? logo.getBoundingClientRect().right : 150;
		const PADDING = 30;

		// Restore mini silently (hamburger-active will be set from the decision below)
		if (hadMini) header.classList.add('mini');

		// Force reflow so the restore is committed before re-enabling transitions
		void header.offsetHeight;

		// Re-enable transitions on the next frame so the user never sees the snapshot
		requestAnimationFrame(() => {
			header.style.transition = '';
			nav.style.transition = '';
			if (logo) logo.style.transition = '';
		});

		// Decision is now based on stable, base-state measurements — no oscillation possible
		const shouldBeHamburger = navRect.width > 0 && navRect.left < logoRight + PADDING;

		if (shouldBeHamburger) {
			nav.classList.add('hide');
			hamburgerBtn.classList.remove('hide');
			header.classList.add('hamburger-active');
		} else {
			nav.classList.remove('hide');
			hamburgerBtn.classList.add('hide');
			header.classList.remove('hamburger-active');
		}
	}

	// detect when the nav collides with the logo when window resizing
	window.addEventListener('resize', checkNavVisibility);

	// Wait for logo image to load before initial check
	if (!logo || logo.complete) {
		checkNavVisibility();
	} else {
		logo.addEventListener('load', checkNavVisibility);
	}
}

function initMobileNav() {
	const hamburgerBtn = document.getElementById('hamburger-btn');
	const slideMenu = document.getElementById('slideMenu');

	hamburgerBtn.addEventListener('click', () => {
		hamburgerBtn.classList.toggle('is-active');
		slideMenu.classList.toggle('open');
	});

	// close meny if clicked anywhere outside of slideMenu
	window.addEventListener('click', (event) => {
		const target = event.target;
		const isClickInsideMenu = slideMenu.contains(target);
		const isClickOnButton = hamburgerBtn.contains(target);

		if (!isClickInsideMenu && !isClickOnButton) {
			hamburgerBtn.classList.remove('is-active');
			slideMenu.classList.remove('open');
		}
	});
}

function initBodyPadding() {
	const header = document.querySelector('header');
	const sonyHeader = document.querySelector('.sony-header');
	const mainWrapper = document.getElementById('main-wrapper');

	if (!header) return;

	function getSonyHeaderHeight() {
		return sonyHeader ? sonyHeader.offsetHeight : 0;
	}

	function updateHeaderTop() {
		header.style.top = `${getSonyHeaderHeight()}px`;
	}

	// Always push the nav below the sony bar
	updateHeaderTop();

	if (NAV_MINI_ONLY && mainWrapper) {
		mainWrapper.style.transition = 'padding-top 200ms';

		function updateBodyPadding() {
			const sonyH = getSonyHeaderHeight();
			const headerHeight = header.offsetHeight;
			mainWrapper.style.paddingTop = `${sonyH + headerHeight}px`;
		}

		updateBodyPadding();

		const resizeObserver = new ResizeObserver(() => {
			updateHeaderTop();
			updateBodyPadding();
		});

		resizeObserver.observe(header);
		if (sonyHeader) resizeObserver.observe(sonyHeader);

		window.addEventListener('resize', () => {
			updateHeaderTop();
			updateBodyPadding();
		});
	} else {
		// Still watch sony bar for resize to keep nav top correct
		if (sonyHeader) {
			const resizeObserver = new ResizeObserver(updateHeaderTop);
			resizeObserver.observe(sonyHeader);
		}
		window.addEventListener('resize', updateHeaderTop);
	}
}

